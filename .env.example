# Django
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_DB=emr_db
POSTGRES_USER=emr_user
POSTGRES_PASSWORD=emr_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
